# Caddy on the Agent Computer VM: HTTPS in front of the interceptor (app-level
# CORS already enabled in oversight.py). `tls internal` = auto self-signed CA,
# zero DNS needed for the demo; swap the address for your real domain and Caddy
# provisions a public cert automatically.

{
    tls internal
}

:443 {
    reverse_proxy 127.0.0.1:8000
    log {
        output file /var/log/caddy/oversight-access.log
    }
}
